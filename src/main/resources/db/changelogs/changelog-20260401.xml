<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260401-01-create-rmq-permission-type" author="moryzang" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="rmq_permission_type"/>
            </not>
        </preConditions>
        <createTable tableName="rmq_permission_type" remarks="权限类型字典表">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="permission_code" type="VARCHAR(50)" remarks="权限代码">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="permission_name" type="VARCHAR(100)" remarks="权限名称">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(300)" remarks="权限描述"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE" remarks="状态"/>
            <column name="created_by" type="VARCHAR(100)" remarks="创建人员">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)" remarks="更新人员">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="DATETIME"
                    defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="rmq_permission_type" indexName="idx_permission_code">
            <column name="permission_code"/>
        </createIndex>
        <createIndex tableName="rmq_permission_type" indexName="idx_permission_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260401-02-create-rmq-permission-topic" author="moryzang" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="rmq_topic"/>
            </not>
        </preConditions>
        <createTable tableName="rmq_topic" remarks="RocketMQ Topic表">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="topic_name" type="VARCHAR(255)" remarks="Topic名称">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="cluster_name" type="VARCHAR(255)" remarks="所属集群名称"/>
            <column name="description" type="VARCHAR(500)" remarks="Topic描述"/>
            <column name="owner_id" type="BIGINT" remarks="所有者用户ID"/>
            <column name="owner_name" type="VARCHAR(100)" remarks="所有者名称"/>
            <column name="read_queue_nums" type="INT" defaultValueNumeric="8" remarks="读队列数量">
                <constraints nullable="false"/>
            </column>
            <column name="write_queue_nums" type="INT" defaultValueNumeric="8" remarks="写队列数量">
                <constraints nullable="false"/>
            </column>
            <column name="message_type" type="VARCHAR(32)" defaultValue="NORMAL"
                    remarks="消息类型：NORMAL/FIFO/DELAY/TRANSACTION">
                <constraints nullable="false"/>
            </column>
            <column name="broker_addr" type="VARCHAR(255)" remarks="broker地址"/>
            <column name="is_system_topic" type="TINYINT(1)" defaultValueNumeric="0" remarks="是否系统Topic"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE" remarks="状态：ACTIVE/INACTIVE/DELETED"/>
            <column name="created_by" type="VARCHAR(100)" remarks="创建人员">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)" remarks="更新人员">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="DATETIME"
                    defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="rmq_topic" indexName="idx_cluster">
            <column name="cluster_name"/>
        </createIndex>
        <createIndex tableName="rmq_topic" indexName="idx_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="rmq_topic" indexName="idx_broker_addr">
            <column name="broker_addr"/>
        </createIndex>
        <createIndex tableName="rmq_topic" indexName="idx_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260401-03-create-rmq-permission-request" author="moryzang" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="rmq_permission_request"/>
            </not>
        </preConditions>
        <createTable tableName="rmq_permission_request" remarks="权限申请表">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT" remarks="申请用户ID">
                <constraints nullable="false"/>
            </column>
            <column name="user_name" type="VARCHAR(100)" remarks="申请用户名">
                <constraints nullable="false"/>
            </column>
            <column name="topic_id" type="BIGINT" remarks="涉及的Topic ID"/>
            <column name="topic_name" type="VARCHAR(255)" remarks="Topic名称"/>
            <column name="permission_type_id" type="BIGINT" remarks="权限类型ID"/>
            <column name="permission_code" type="VARCHAR(50)" remarks="权限代码">
                <constraints nullable="false"/>
            </column>
            <column name="request_reason" type="VARCHAR(500)" remarks="申请理由"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING" remarks="申请状态"/>
            <column name="approver_id" type="BIGINT" remarks="审批人ID"/>
            <column name="approver_name" type="VARCHAR(100)" remarks="审批人名称"/>
            <column name="approval_reason" type="VARCHAR(500)" remarks="审批意见"/>
            <column name="approval_time" type="TIMESTAMP" remarks="审批时间"/>
            <column name="expire_time" type="TIMESTAMP" remarks="权限过期时间"/>
            <column name="created_by" type="VARCHAR(100)" remarks="创建人员">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)" remarks="更新人员">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="DATETIME"
                    defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="rmq_permission_request" indexName="idx_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="rmq_permission_request" indexName="idx_topic_id">
            <column name="topic_id"/>
        </createIndex>
        <createIndex tableName="rmq_permission_request" indexName="idx_permission_type">
            <column name="permission_type_id"/>
        </createIndex>
        <createIndex tableName="rmq_permission_request" indexName="idx_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="rmq_permission_request" indexName="idx_created_date">
            <column name="created_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260401-04-create-rmq-user-permission" author="moryzang" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="rmq_user_permission"/>
            </not>
        </preConditions>
        <createTable tableName="rmq_user_permission" remarks="用户权限关系表">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT" remarks="用户ID">
                <constraints nullable="false"/>
            </column>
            <column name="user_name" type="VARCHAR(100)" remarks="用户名">
                <constraints nullable="false"/>
            </column>
            <column name="topic_id" type="BIGINT" remarks="Topic ID"/>
            <column name="topic_name" type="VARCHAR(255)" remarks="Topic名称"/>
            <column name="permission_type_id" type="BIGINT" remarks="权限类型ID"/>
            <column name="permission_code" type="VARCHAR(50)" remarks="权限代码">
                <constraints nullable="false"/>
            </column>
            <column name="granted_by_id" type="BIGINT" remarks="授权人ID"/>
            <column name="granted_by_name" type="VARCHAR(100)" remarks="授权人名称"/>
            <column name="granted_time" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="授权时间"/>
            <column name="expire_time" type="TIMESTAMP" remarks="权限过期时间"/>
            <column name="is_expired" type="TINYINT(1)" defaultValueNumeric="0" remarks="是否已过期"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE" remarks="状态：ACTIVE/REVOKED/EXPIRED"/>
            <column name="created_by" type="VARCHAR(100)" remarks="创建人员">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)" remarks="更新人员">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="DATETIME"
                    defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="rmq_user_permission"
                             columnNames="user_id,topic_id,permission_type_id"
                             constraintName="uk_user_topic_perm"/>
        <createIndex tableName="rmq_user_permission" indexName="idx_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="rmq_user_permission" indexName="idx_topic_id">
            <column name="topic_id"/>
        </createIndex>
        <createIndex tableName="rmq_user_permission" indexName="idx_permission_type">
            <column name="permission_type_id"/>
        </createIndex>
        <createIndex tableName="rmq_user_permission" indexName="idx_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="rmq_user_permission" indexName="idx_expire_time">
            <column name="expire_time"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260401-05-create-rmq-permission-audit-log" author="moryzang" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="rmq_permission_audit_log"/>
            </not>
        </preConditions>
        <createTable tableName="rmq_permission_audit_log" remarks="权限审计日志表">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="operation_type" type="VARCHAR(50)" remarks="操作类型">
                <constraints nullable="false"/>
            </column>
            <column name="operator_id" type="BIGINT" remarks="操作人ID"/>
            <column name="operator_name" type="VARCHAR(100)" remarks="操作人名称"/>
            <column name="target_user_id" type="BIGINT" remarks="目标用户ID"/>
            <column name="target_user_name" type="VARCHAR(100)" remarks="目标用户名"/>
            <column name="topic_id" type="BIGINT" remarks="Topic ID"/>
            <column name="topic_name" type="VARCHAR(255)" remarks="Topic名称"/>
            <column name="permission_code" type="VARCHAR(50)" remarks="权限代码"/>
            <column name="request_id" type="BIGINT" remarks="关联的权限申请ID"/>
            <column name="operation_details" type="JSON" remarks="操作详情"/>
            <column name="operation_result" type="TINYINT(1)" defaultValueNumeric="1" remarks="操作结果"/>
            <column name="error_message" type="VARCHAR(500)" remarks="错误信息"/>
            <column name="ip_address" type="VARCHAR(50)" remarks="操作人IP"/>
            <column name="created_by" type="VARCHAR(100)" remarks="创建人员">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)" remarks="更新人员">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="DATETIME"
                    defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="rmq_permission_audit_log" indexName="idx_operation_type">
            <column name="operation_type"/>
        </createIndex>
        <createIndex tableName="rmq_permission_audit_log" indexName="idx_operator_id">
            <column name="operator_id"/>
        </createIndex>
        <createIndex tableName="rmq_permission_audit_log" indexName="idx_target_user_id">
            <column name="target_user_id"/>
        </createIndex>
        <createIndex tableName="rmq_permission_audit_log" indexName="idx_request_id">
            <column name="request_id"/>
        </createIndex>
        <createIndex tableName="rmq_permission_audit_log" indexName="idx_created_date">
            <column name="created_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260401-06-create-rmq-consumer-monitor" author="moryzang" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="rmq_consumer_monitor"/>
            </not>
        </preConditions>
        <createTable tableName="rmq_consumer_monitor" remarks="消费组监控配置表">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="group_name" type="VARCHAR(255)" remarks="消费组名称">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="min_count" type="INT" defaultValueNumeric="0" remarks="最小消费实例数阈值">
                <constraints nullable="false"/>
            </column>
            <column name="max_diff_total" type="INT" defaultValueNumeric="0" remarks="最大堆积总量阈值">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)" remarks="创建人员">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)" remarks="更新人员">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="DATETIME"
                    defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="rmq_consumer_monitor" indexName="idx_updated_date">
            <column name="updated_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>